/* ==========================================================================
   DASHBOARD
   ========================================================================== */

.dashboard{

    display:flex;

    flex-direction:column;

    gap:20px;

    padding:20px;

}

.dashboard-top{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:20px;

    align-items:start;

}

.dashboard-bottom{

    width:100%;

}

.card{

    background:#fff;

    border-radius:10px;

    padding:15px;

    box-shadow:0 2px 8px rgba(0,0,0,.15);

}

.card h2{

    margin-bottom:15px;

}

@media(max-width:900px){

    .dashboard-top{

        grid-template-columns:1fr;

    }

}
